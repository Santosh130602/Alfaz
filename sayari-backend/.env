# ── WhatsApp (WATI) ───────────────────────────────
WHATSAPP_PROVIDER=console
WATI_API_URL=https://live-server.wati.io
WATI_ACCESS_TOKEN=your_wati_token
WATI_OTP_TEMPLATE_NAME=sayari_otp
WATI_WEBHOOK_VERIFY_TOKEN=your_random_verify_token
WATI_WEBHOOK_SECRET=your_wati_hmac_secret

# ── Kafka (optional) ──────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=kafka:9092

# ── Security ─────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ── OTP ──────────────────────────────────────────
OTP_EXPIRY_MINS=10
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECS=60

# ── Uploads ───────────────────────────────────────
MAX_IMAGE_MB=15
MAX_AUDIO_MB=100
MAX_ASSET_MB=20

# ── Puppeteer (canvas → image rendering) ─────────
CHROMIUM_PATH=/usr/bin/chromium-browser
PUPPETEER_SKIP_DOWNLOAD=true

# ── Google Drive ──────────────────────────────────
DRIVE_QUOTA_WARNING_PCT=0.80

# ── Logging ──────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ── Seeder ───────────────────────────────────────
SEED_ADMIN_EMAIL=santosh13@admin.com
SEED_ADMIN_PASSWORD=Santosh@1306
SEED_ADMIN_USERNAME=santosh_13

# ── Testing ──────────────────────────────────────
TEST_MONGODB_URI=mongodb://localhost:27017/sayari_test
