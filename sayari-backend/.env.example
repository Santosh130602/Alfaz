# ════════════════════════════════════════════════
#  SAYARI PLATFORM — COMPLETE .env
#  Copy to .env and fill in values
#  Never commit .env to version control
# ════════════════════════════════════════════════

# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
ENABLE_DOCS=true

# ── MongoDB ──────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=changeme_strong_password
MONGODB_URI=mongodb://admin:changeme@mongo:27017/sayari?authSource=admin

# ── Redis ─────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:changeme_redis_password@redis:6379

# ── JWT (generate with: openssl rand -hex 64) ────
JWT_ACCESS_SECRET=generate_64char_secret_here_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=generate_64char_secret_here_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── Google OAuth + Drive ─────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Cookies ───────────────────────────────────────
COOKIE_SECURE=false          # production में true कर देना (HTTPS ज़रूरी है तब)
COOKIE_SAMESITE=lax          # cross-site हो तो 'none' + secure:true चाहिए

# ── Apple OAuth ───────────────────────────────────
APPLE_CLIENT_ID=com.yourcompany.sayari
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"

# ── Firebase FCM (push notifications) ────────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ── WhatsApp (WATI) ───────────────────────────────
WHATSAPP_PROVIDER=console
WATI_API_URL=https://live-server.wati.io
WATI_ACCESS_TOKEN=your_wati_token
WATI_OTP_TEMPLATE_NAME=sayari_otp
WATI_WEBHOOK_VERIFY_TOKEN=your_random_verify_token
WATI_WEBHOOK_SECRET=your_wati_hmac_secret

# ── Kafka (optional) ──────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=kafka:9092

# ── Security ─────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ── OTP ──────────────────────────────────────────
OTP_EXPIRY_MINS=10
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECS=60

# ── Uploads ───────────────────────────────────────
MAX_IMAGE_MB=15
MAX_AUDIO_MB=100
MAX_ASSET_MB=20

# ── Puppeteer (canvas → image rendering) ─────────
CHROMIUM_PATH=/usr/bin/chromium-browser
PUPPETEER_SKIP_DOWNLOAD=true

# ── Google Drive ──────────────────────────────────
DRIVE_QUOTA_WARNING_PCT=0.80

# ── Logging ──────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ── Seeder ───────────────────────────────────────
SEED_ADMIN_EMAIL=admin@sayari.app
SEED_ADMIN_PASSWORD=ChangeThisNow@2025
SEED_ADMIN_USERNAME=sayari_admin

# ── Testing ──────────────────────────────────────
TEST_MONGODB_URI=mongodb://localhost:27017/sayari_test
